#
# Package a locally built distribution over a reviewed frontend base image.
# Supply dist/ as the named "bundle" build context.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN rm -rf /usr/share/nginx/html/v-* \
    /usr/share/nginx/html/images \
    /usr/share/nginx/html/index.html \
    /usr/share/nginx/html/loading.css \
    /usr/share/nginx/html/conf.json

COPY --from=bundle / /usr/share/nginx/html/
COPY docker/conf.json.template /usr/share/nginx/html/conf.json.template
COPY docker/config_env_subst.sh /docker-entrypoint.d/30_config_env_subst.sh

RUN set -eu; \
    chmod +x /docker-entrypoint.d/30_config_env_subst.sh; \
    test -s /usr/share/nginx/html/index.html; \
    test -s /usr/share/nginx/html/loading.css; \
    test -s /usr/share/nginx/html/v-*/styles/theme-taiga.css; \
    test -s /usr/share/nginx/html/v-*/styles/theme-taiga-dark.css
